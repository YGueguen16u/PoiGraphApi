FROM eclipse-temurin:17-jdk-jammy

LABEL maintainer="Yann Gueguen <https://github.com/YGueguen16u>"
LABEL org.opencontainers.image.authors="Yann Gueguen"
LABEL org.opencontainers.image.source="https://github.com/YGueguen16u/PoiGraphApi"
LABEL org.opencontainers.image.description="Standalone Apache Spark environment for local data engineering and analytics"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.version="1.0.0"

RUN apt-get update && apt-get install -y python3 python3-pip wget curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV SPARK_VERSION=3.5.0
ENV HADOOP_VERSION=3
ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$PATH

RUN wget https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz && \
    tar xzf spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz -C /opt && \
    mv /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} $SPARK_HOME && \
    rm spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz

RUN pip install pyspark==3.5.0 findspark requests pandas

WORKDIR /app

# Expose Spark UI & master port
EXPOSE 8080 7077 4040

# Default command
CMD ["bash"]